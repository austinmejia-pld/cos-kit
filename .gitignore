```gitignore
# Private state
memory/
state/
logs/
cache/

# Secrets
.env
.env.*
.tokens/
.secrets/
*.key
*.pem
client_secret*.json

# Local DB/artifacts
*.db
*.sqlite
*.sqlite3
*.log
.DS_Store
.artifacts/

# Claude local settings (contains machine-specific paths)
.claude/settings.local.json

# Python/Node misc (if used)
__pycache__/
node_modules/
dist/
build/
memory/
