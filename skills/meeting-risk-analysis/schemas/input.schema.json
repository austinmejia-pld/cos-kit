{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meeting-risk-analysis/input/v1",
  "title": "MeetingRiskAnalysisInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["meeting_id", "meeting_title", "transcript", "participants", "context"],
  "properties": {
    "meeting_id": {
      "type": "string",
      "minLength": 1
    },
    "meeting_title": {
      "type": "string",
      "minLength": 1
    },
    "transcript": {
      "type": "string",
      "minLength": 100
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "context": {
      "$ref": "#/definitions/context"
    },
    "meeting_date": {
      "type": "string",
      "format": "date"
    },
    "domain": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prior_decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strategic_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
