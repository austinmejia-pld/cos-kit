{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "interview-analysis/input/v1",
  "title": "InterviewAnalysisInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_name", "role", "stage", "transcript", "rubric"],
  "properties": {
    "candidate_name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": ["recruiter_screen", "hiring_manager", "onsite", "panel", "final"]
    },
    "transcript": {
      "type": "string",
      "minLength": 50
    },
    "rubric": {
      "$ref": "#/definitions/rubric"
    },
    "interviewer": {
      "type": "string"
    },
    "must_have_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interview_date": {
      "type": "string",
      "format": "date"
    },
    "interview_id": {
      "type": "string"
    },
    "rubric_version": {
      "type": "string"
    }
  },
  "definitions": {
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/dimension"
          }
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "scale_min", "scale_max"],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "scale_min": {
          "type": "integer",
          "const": 1
        },
        "scale_max": {
          "type": "integer",
          "const": 4
        },
        "must_have": {
          "type": "boolean"
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/anchor"
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "definition"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "definition": {
          "type": "string"
        }
      }
    }
  }
}
