{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "interview-analysis/output/v1",
  "title": "InterviewAnalysisOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation",
    "confidence",
    "decision_summary",
    "dimension_scores",
    "strengths",
    "concerns",
    "risk_flags",
    "interviewer_feedback",
    "follow_up_questions"
  ],
  "properties": {
    "recommendation": {
      "type": "string",
      "enum": ["strong_yes", "yes", "mixed", "no", "strong_no"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decision_summary": {
      "type": "string",
      "minLength": 20
    },
    "dimension_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/dimension_score"
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interviewer_feedback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_up_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "dimension_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "score", "rationale", "evidence_quotes"],
      "properties": {
        "dimension": {
          "type": "string"
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "rationale": {
          "type": "string"
        },
        "evidence_quotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
